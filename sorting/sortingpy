#insertion sort


n= int(input())
lst= list(map(int,input().split()))



for i in range(1,n):
  kunci=lst[i]
  j= i-1

  while j >= 0 and lst[j] > kunci:
    lst[j + 1] = lst[j]
    j -= 1
# sisipkan ke posisi yang benar
    lst[j + 1] = kunci


